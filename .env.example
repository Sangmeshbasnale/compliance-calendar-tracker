# =============================================================================
#  Compliance Calendar Tracker — Environment Variable Template
#  Copy this file to .env and fill in real values before running.
#  NEVER commit the real .env to version control.
# =============================================================================

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=compliance_db
POSTGRES_USER=compliance_user
POSTGRES_PASSWORD=CHANGE_ME

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME

# ── JWT (generate: openssl rand -base64 64) ───────────────────────────────────
JWT_SECRET=CHANGE_ME

# ── Mail (SMTP) ───────────────────────────────────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME@gmail.com
MAIL_PASSWORD=CHANGE_ME
APP_MAIL_FROM=CHANGE_ME@gmail.com
APP_MAIL_ADMIN=admin@yourcompany.com

# ── Spring ────────────────────────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=docker

# ── Frontend (Vite build-time + runtime) ─────────────────────────────────────
# Set to your server's public IP/domain for production deployments
VITE_API_URL=http://localhost:8080
VITE_AI_URL=http://localhost:5000

# ── AI Service (Flask / Gunicorn) ─────────────────────────────────────────────
AI_WORKERS=2
AI_LOG_LEVEL=info
